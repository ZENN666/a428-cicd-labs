node {

    deleteDir()

    stage('Checkout') {
        checkout scm
    }

    docker.image('node:16-alpine').inside('-p 3000:3000 -e HOME=/tmp') {
        
        withEnv([
            'CI=true',
            'npm_config_cache=/tmp/.npm-cache',  
            'HOME=/tmp'                          
        ]) {
            
            stage('Build') {
                sh 'npm install --cache /tmp/.npm-cache --no-fund --prefer-offline || npm install --cache /tmp/.npm-cache'
            }
            
            stage('Test') {
                sh './jenkins/scripts/test.sh'
            }
            
            stage('Manual Approval') {
                input message: 'Lanjutkan ke tahap Deploy?'
            }
            
            stage('Deploy') {
                sh './jenkins/scripts/deliver.sh'
                sleep time: 60, unit: 'SECONDS'
                sh './jenkins/scripts/kill.sh'
            }
        }
    }
}