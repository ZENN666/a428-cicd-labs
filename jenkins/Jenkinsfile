node {
    stage('Checkout') {
        checkout scm
    }

    docker.image('node:lts-buster-slim').inside('-p 9999:3000') {
        
        withEnv(['npm_config_cache=/tmp/.npm', 'CI=true']) {
            
            stage('Build') {
                sh 'mkdir -p /tmp/.npm'
                sh 'npm install'
            }
            
            stage('Test') {
                sh './jenkins/scripts/test.sh'
            }
            
            stage('Deliver') {
                sh './jenkins/scripts/deliver.sh'
                input message: 'Finished using the website? (Click "Proceed" to continue)'
                sh './jenkins/scripts/kill.sh'
            }
            
        }
    }
}