node {
    stage('Checkout') {
        checkout scm
    }

    // Balikin ke asal, hapus -u root:root nya
    docker.image('node:16-alpine').inside('-p 3000:3000') {
        
        // Kita paksa npm bikin cache di dalam folder project aja biar nggak ditolak sistem
        withEnv(['CI=true', 'npm_config_cache=npm-cache']) {
            
            stage('Build') {
                sh 'npm install'
            }
            
            stage('Test') {
                sh './jenkins/scripts/test.sh'
            }
            
            stage('Manual Approval') {
                input message: 'Lanjutkan ke tahap Deploy?'
            }
            
            stage('Deploy') {
                sh './jenkins/scripts/deliver.sh'
                sleep time: 60, unit: 'SECONDS'
                sh './jenkins/scripts/kill.sh'
            }
            
        }
    }
}